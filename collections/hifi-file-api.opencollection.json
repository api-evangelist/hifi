{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hifi Account File API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "File",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload a file",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://production.hifibridge.com/v2/files",
            "body": {
              "type": "multipart-form",
              "data": []
            }
          },
          "docs": "Upload a file.\n"
        }
      ]
    }
  ],
  "bundled": true
}